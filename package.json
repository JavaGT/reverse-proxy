{
  "name": "@javagt/reverse-proxy",
  "version": "2.0.2",
  "description": "Personal production reverse proxy — route HTTP/WS traffic to locally-registered backends by hostname",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "reverse-proxy": "./bin/reverse-proxy.js"
  },
  "workspaces": [
    "sdk"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test tests/*.test.js sdk/tests/*.test.js",
    "start:cli": "node bin/reverse-proxy.js start"
  },
  "keywords": [
    "reverse-proxy",
    "http-proxy",
    "websocket-proxy",
    "service-registry"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JavaGT/reverse-proxy.git"
  },
  "dependencies": {
    "acme-client": "^5.4.0",
    "commander": "^14.0.3",
    "dotenv": "^16.4.5",
    "http2-proxy": "^5.0.53"
  }
}
